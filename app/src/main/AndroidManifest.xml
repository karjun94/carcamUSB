<?xml version="1.0" encoding="utf-8"?>
<!-- Permissions, the steering-button watcher and its boot receiver come from :camcore. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme">

        <activity
            android:name=".CameraActivity"
            android:theme="@style/CameraTheme"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Sent by the shared button watcher and settings screen (see CameraActions). -->
            <intent-filter>
                <action android:name="com.karjun.dmaxcam.action.TOGGLE_CAMERA" />
                <action android:name="com.karjun.dmaxcam.action.OPEN_CAMERA" />
                <action android:name="com.karjun.dmaxcam.action.ADJUST_GUIDES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Lets Android remember the USB permission ("Use by default") and open us on plug-in. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <activity
            android:name="com.karjun.dmaxcam.core.SettingsActivity"
            android:exported="true"
            android:label="D-Max Cam Settings"
            android:icon="@mipmap/ic_launcher_settings"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
