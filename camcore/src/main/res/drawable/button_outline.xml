<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><solid android:color="#332EC4B6" /><stroke android:width="2dp" android:color="@color/accent" /><corners android:radius="16dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/chip" /><stroke android:width="2dp" android:color="@color/accent" /><corners android:radius="16dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><stroke android:width="2dp" android:color="@color/accent" /><corners android:radius="16dp" /></shape>
    </item>
</selector>
