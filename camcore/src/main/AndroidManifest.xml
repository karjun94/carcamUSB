<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into both apps: the steering-button watcher and its boot starter. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- Android 9+ only hands USB video devices to apps that hold CAMERA. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Granted over ADB (appops) so the watcher may bring the camera to the front. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Granted over ADB (pm grant); used to see steering-wheel keys in the system log. -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />

    <application>
        <service
            android:name="com.karjun.dmaxcam.core.KeyWatchService"
            android:exported="false" />

        <receiver
            android:name="com.karjun.dmaxcam.core.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
